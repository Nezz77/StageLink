generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  topic          String
  payload        Json
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)
  enqueuedAt     DateTime? @map("enqueued_at") @db.Timestamptz(3)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)
  deadLetteredAt DateTime? @map("dead_lettered_at") @db.Timestamptz(3)
  attempts       Int       @default(0)
  lastErrorCode  String?   @map("last_error_code")
  consumedEvents ConsumedEvent[]
  receipt FoundationReceipt?
  @@map("outbox_events")
}

model ConsumedEvent {
  consumer    String
  eventId     String    @map("event_id") @db.Uuid
  processedAt DateTime  @default(now()) @map("processed_at") @db.Timestamptz(3)
  event OutboxEvent @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([consumer, eventId])
  @@map("consumed_events")
}

// Harmless internal effect; not a business record or production fixture.
model FoundationReceipt {
  eventId    String   @id @map("event_id") @db.Uuid
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  event OutboxEvent @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@map("foundation_receipts")
}
